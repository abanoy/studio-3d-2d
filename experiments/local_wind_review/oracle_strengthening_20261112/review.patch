+func owned_source_meshes(source: RefCounted) -> Array:
+	# Independent test inventory: never take the product's hidden list or its
+	# Groups.mesh_nodes result as proof that it found every owned source mesh.
+	var excluded: Array=[];var found: Array=[];var pending: Array=[source.root]
+	for current in app.renderer.world_runtime.instances.values():
+		if current!=source:excluded.append(current.root)
+	while not pending.is_empty():
+		var node: Node=pending.pop_back()
+		if node!=source.root and node in excluded:continue
+		if node is MeshInstance3D and node.mesh:found.append(node)
+		pending.append_array(node.get_children())
+	return found
+
+func mesh_id_set(meshes: Array) -> Dictionary:
+	var result: Dictionary={}
+	for mesh in meshes:result[mesh.get_instance_id()]=true
+	return result
 
