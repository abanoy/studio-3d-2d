extends "res://tests/shortcut_editor_smoke.gd"
const Timeline=preload("res://src/timeline.gd")
func type_number(field: SpinBox,text: String) -> void:
	app.inspector_scroll.ensure_control_visible(field);await settle();await click(field.get_line_edit())
	press(KEY_A,true)
	for character in text:
		for down in [true,false]:
			var e:=InputEventKey.new();e.keycode=character.unicode_at(0);e.unicode=character.unicode_at(0);e.pressed=down;root.push_input(e,true)
	await settle()
func run() -> void:
	var folder: String=OS.get_cmdline_user_args()[0];var reading: bool="--read" in OS.get_cmdline_user_args()
	app=load("res://main.tscn").instantiate();app.display_prefs_path=folder.path_join("prefs.cfg");app.recovery_root=folder.path_join("recovery-cold" if reading else "recovery");app.recent_path=folder.path_join("recent.json");root.add_child(app);await settle();app.home.hide();app.autosave_enabled.button_pressed=false;app.has_project.cache_root=folder.path_join("cache-cold" if reading else "cache")
	var editor=app.camera_transform_editor;var packed:=folder.path_join("Numeric camera.has")
	if reading:
		app.has_project.open_file(packed);await wait_job();var expected: Dictionary=JSON.parse_string(FileAccess.get_file_as_string(folder.path_join("expected.json")))
		check(app.keys==expected.keys and not editor.controls.visible and editor.context.is_empty(),"cold HAS preserves exact explicit keys without transient numeric draft")
		check(Storage.image_hash(Drawing.image(Drawing.cel_at(app.layers[1],0)))==expected.paint and Storage.image_hash(await app.renderer.capture(app.keys,app.layers,12,true))==expected.render,"cold scene preserves independent paint and exact authored shot output")
		print("CAMERA_TRANSFORM_READ ",JSON.stringify({"checks":checks,"failures":failures}));app.free();quit(0 if failures==0 else 1);return
	check(app.load_demo_room(),"original animated environment loads")
	app.mode.select(1);app.change_mode(1);app.set_frame(12);app.renderer.evaluate(app.keys,12)
	var drawing:=Drawing.blank(1920,1080);drawing.fill_rect(Rect2i(760,420,120,90),Color.CYAN);Drawing.insert(app.layers[1],0,48,drawing);app.changed()
	var paint:=Storage.image_hash(drawing);var keys: Array=app.keys.duplicate(true);var history: int=app.history.size();var revision: int=app.recovery_revision;var dirty: bool=app.dirty;var original: Dictionary=app.renderer.view_state();var source:=FileAccess.get_sha256(app.source)
	root.size=Vector2i(1200,760);app.set_advanced(false);await settle();check(not editor.launch.is_visible_in_tree(),"Simple keeps detailed camera numbers hidden")
	app.set_advanced(true);await settle();app.inspector_scroll.ensure_control_visible(editor.launch);await settle();await click(editor.launch);check(editor.controls.visible and editor.context.frame==12,"actual Advanced button opens current-frame camera draft")
	check(app.inspector_scroll.get_global_rect().encloses(editor.hint.get_global_rect()),"numeric view guidance is revealed inside the laptop inspector")
	app.inspector_scroll.ensure_control_visible(editor.apply_button);await settle();await click(editor.apply_button)
	check(app.renderer.view_state()==original and app.keys==keys,"unchanged Apply preserves exact view and shot keys")
	await type_number(editor.fields[0],"-2.25");check(editor.fields[0].get_line_edit().text=="-2.25" and editor.has_draft(),"actual typed coordinate is tracked before numeric commit")
	app.key_dialog();check(app.keys==keys and "numeric camera draft" in app.status.text,"explicit key refuses an unapplied numeric draft")
	app.inspector_scroll.ensure_control_visible(editor.apply_button);await settle();await click(editor.apply_button)
	check(app.renderer.camera.position.x==-2.25 and app.renderer.camera.position.y==original.transform.origin.y and app.renderer.camera.position.z==original.transform.origin.z and app.renderer.camera.basis==original.transform.basis,"Apply uses typed X and preserves untouched exact components/basis")
	check(app.keys==keys and app.history.size()==history and app.recovery_revision==revision and app.dirty==dirty and Storage.image_hash(drawing)==paint,"temporary numeric navigation does not author keys/history/recovery/drawing changes")
	var position: Vector3=app.renderer.camera.position;editor.fields[4].value=-25.;editor.apply_view();check(app.renderer.camera.position==position and absf(rad_to_deg(app.renderer.camera.basis.get_euler(EULER_ORDER_YXZ).y)+25.)<.001,"yaw changes with position preserved")
	app.set_advanced(false);check(app.renderer.camera.position==position and not editor.has_draft(),"Simple presentation preserves applied camera view")
	app.key_dialog();check(app.keys.size()==keys.size()+1 and app.history.size()==history+1,"normal explicit key records applied numeric camera once")
	var keyed: Array=app.keys.duplicate(true);app.undo();check(app.keys==keys,"one Undo restores original keys");app.redo();check(app.keys==keyed,"Redo restores authored numeric view key")
	app.mode.select(0);app.change_mode(0);await settle();var expected_render: Image=await app.renderer.capture(app.keys,app.layers,12,true)
	check(Storage.image_hash(drawing)==paint and FileAccess.get_sha256(app.source)==source,"numeric camera editing leaves original environment and paint unchanged")
	app.mode.select(1);app.change_mode(1);app.set_advanced(true);editor.open();editor.fields[2].value+=.5;var navigation: Dictionary=app.renderer.view_state();navigation.transform.origin.x+=.75;app.renderer.restore_view(navigation);await settle()
	check(editor.stale and editor.apply_button.disabled,"manual camera change makes pending numeric draft stale");editor.apply_view();check(app.renderer.view_state()==navigation,"stale Apply cannot overwrite a newer view")
	editor.reload_view();check(not editor.stale and not editor.has_draft(),"reload discards stale draft and reads current view")
	editor.fields[1].value+=.25;app.set_frame(13);await settle();check(editor.stale,"frame change invalidates numeric draft");editor.reload_view()
	app.playing=true;editor.fields[0].value+=.25;var before: Transform3D=app.renderer.camera.transform;editor.apply_view();check(app.renderer.camera.transform==before,"playback refuses numeric Apply");app.stop();editor.reload_view()
	app.exporting=true;before=app.renderer.camera.transform;editor.fields[0].value+=.5;editor.apply_view();check(app.renderer.camera.transform==before,"export refuses numeric Apply");app.exporting=false;editor.reload_view()
	app.mode.select(0);app.change_mode(0);before=app.renderer.camera.transform;editor.fields[0].value+=.5;editor.apply_view();check(app.renderer.camera.transform==before,"Draw mode refuses numeric Apply")
	app.mode.select(1);app.change_mode(1);editor.reload_view();await settle();app.inspector_scroll.ensure_control_visible(editor.apply_button);await settle();root.get_texture().get_image().save_png(folder.path_join("numeric-camera-1200.png"))
	app.mode.select(0);app.change_mode(0);app.set_frame(12);app.has_project.save_file(packed,"packed");await wait_job();check(app.has_project.path==packed,"ordinary packed HAS save preserves explicit numeric shot")
	var error: String=await app.export_movie(folder)
	check(error.is_empty() and Image.load_from_file(app.last_export_folder.path_join("frame_000013.png")).get_data()==expected_render.get_data(),"actual MP4 input frame equals explicit numeric shot plus independent drawing")
	var movie: String=app.last_export_folder.path_join("movie.mp4")
	FileAccess.open(folder.path_join("expected.json"),FileAccess.WRITE).store_string(JSON.stringify({"paint":paint,"keys":keyed,"render":Storage.image_hash(expected_render)},"",true,true))
	app.mode.select(1);app.change_mode(1);editor.open();editor.fields[0].value+=2.;app.new_project();await settle();check(not editor.controls.visible and editor.context.is_empty() and not editor.has_draft(),"New scene clears transient numeric draft")
	var result:={"checks":checks,"failures":failures,"movie":movie};FileAccess.open(folder.path_join("result.json"),FileAccess.WRITE).store_string(JSON.stringify(result));print("CAMERA_TRANSFORM_SMOKE ",JSON.stringify(result));app.free();quit(0 if failures==0 else 1)
