extends "res://tests/movement_path_smoke.gd"
const Drawing=preload("res://src/drawing.gd")
const Storage=preload("res://src/storage.gd")
func _initialize() -> void:
	create_timer(130).timeout.connect(func():push_error("Cel clipboard watchdog");quit(2));call_deferred("run")
func open_at(layer: int,at: int) -> void:
	var view=app.timeline;var event:=InputEventMouseButton.new();event.button_index=MOUSE_BUTTON_RIGHT;event.pressed=true;event_at(view,Vector2(view.x(at),view.layer_y(layer)+12),event);await settled()
func action(id: int) -> void:
	app.cel_clipboard.menu.id_pressed.emit(id);await settled()
func paint_hash(at: int) -> String:
	var cel:=Drawing.cel_at(app.layers[1],at)
	return "" if cel.is_empty() else Storage.image_hash(cel.image)
func run() -> void:
	folder=OS.get_cmdline_user_args()[0];app=load("res://main.tscn").instantiate();app.recovery_root=folder.path_join("recovery");app.recent_path=folder.path_join("recents.json");app.display_prefs_path=folder.path_join("prefs.cfg");root.add_child(app);await settled();app.home.hide();app.autosave_enabled.button_pressed=false;app.has_project.cache_root=folder.path_join("reader-cache" if "--read" in OS.get_cmdline_user_args() else "writer-cache")
	if "--read" in OS.get_cmdline_user_args():
		app.has_project.open_file(folder.path_join("clipboard.has"));await wait_job();var expected: Dictionary=JSON.parse_string(FileAccess.get_file_as_string(folder.path_join("expected.json")))
		check(app.layers[1].cels.size()==3 and paint_hash(0)==expected.original and paint_hash(16)==expected.edited and paint_hash(32)==expected.original,"cold packed Open restores independent source, edited paste and unchanged repeated paste")
		check(app.layers[1].cels[1].start==16 and app.layers[1].cels[1].duration==8 and app.layers[1].cels[2].start==32 and app.layers[1].cels[2].duration==8,"cold Open preserves complete exposure ranges")
		check(app.cel_clipboard.clipboard.is_empty(),"transient clipboard is not saved as project state")
		var picture: Image=await app.renderer.capture(app.keys,app.layers,16,true)
		check(picture.get_data()==Image.load_from_file(folder.path_join("frame16.png")).get_data(),"cold final picture matches edited pasted drawing exactly")
		print("CEL_CLIPBOARD_READ "+JSON.stringify({"checks":checks,"failures":failures}));await app.quit_studio();quit(0 if failures==0 else 1);return
	app.mode.select(0);app.change_mode(0)
	var image:=Drawing.blank(1920,1080);image.fill_rect(Rect2i(100,100,100,70),Color(.2,.7,.9,.5));Drawing.touch(image);Drawing.insert(app.layers[1],0,48,image);app.layers[1].cels[0].duration=8;app.changed();await settled()
	var original:=Storage.image_hash(image);var keys: Array=app.keys.duplicate(true);var world: Dictionary=app.current_world().duplicate(true);var history: int=app.history.size();var revision: int=app.recovery_revision
	await open_at(1,4)
	check(app.cel_clipboard.menu.visible and not app.timeline.import_menu.visible and app.cel_clipboard.menu.get_item_text(0)=="Copy drawing","right-click drawing row opens actual dedicated menu, not model import actions")
	check(not app.cel_clipboard.menu.is_item_disabled(0) and app.cel_clipboard.menu.is_item_disabled(2),"copy/cut enabled on drawing and paste unavailable before Copy")
	await action(0)
	check(app.history.size()==history and app.recovery_revision==revision and not app.cel_clipboard.clipboard.is_empty(),"Copy captures drawing without document edit or Undo command")
	check(not is_same(app.cel_clipboard.clipboard.image,image) and app.cel_clipboard.clipboard.image.get_data_size()==8294400,"clipboard owns one independent bounded fullHD Image")
	image.fill_rect(Rect2i(300,100,30,30),Color.RED);Drawing.touch(image);app.changed();var changed:=Storage.image_hash(image)
	await open_at(1,16);check(app.cel_clipboard.menu.visible and app.cel_clipboard.menu.is_item_disabled(0) and not app.cel_clipboard.menu.is_item_disabled(2),"right-click empty range exposes Paste without a source cel")
	await action(2)
	check(paint_hash(16)==original and paint_hash(0)==changed and app.layers[1].cels[1].duration==8,"Paste uses frozen copied pixels and complete original exposure despite later source painting")
	check(not is_same(app.layers[1].cels[1].image,image) and app.layers[1].cels[1].id!=app.layers[1].cels[0].id,"pasted cel has fresh stable identity and independent editable raster")
	app.undo();check(app.layers[1].cels.size()==1 and paint_hash(0)==changed,"Paste Undo removes only the new exposure")
	app.redo();check(app.layers[1].cels.size()==2 and paint_hash(16)==original,"Paste Redo restores its original independent drawing")
	var pasted: Image=Drawing.cel_at(app.layers[1],16).image;pasted.fill_rect(Rect2i(500,100,25,25),Color.GREEN);Drawing.touch(pasted);app.changed();var edited:=Storage.image_hash(pasted)
	await open_at(1,32);await action(2)
	check(paint_hash(32)==original and paint_hash(16)==edited and paint_hash(0)==changed,"editing pasted cel does not alter source, clipboard or another pasted cel")
	var before: Array=app.layers[1].cels.duplicate(true);history=app.history.size()
	await open_at(1,18);await action(2);check(app.layers[1].cels==before and app.history.size()==history,"overlapping paste refuses without trimming or overwriting any drawing")
	await open_at(1,44);await action(2);check(app.layers[1].cels==before and app.history.size()==history,"past-scene exposure refuses without shortening the copied drawing")
	await open_at(0,16);check(app.cel_clipboard.menu.is_item_disabled(2),"cross-layer paste stays unavailable")
	app.cel_clipboard.menu.hide();await settled()
	await open_at(1,40);app.changed();await action(2);check(app.layers[1].cels==before and app.history.size()==history,"stale menu revision cannot paste into changed document")
	await open_at(1,4);app.exporting=true;var refused: bool=not app.cel_clipboard.perform("cut");app.exporting=false;app.cel_clipboard.menu.hide();await settled()
	check(refused and app.layers[1].cels==before and app.history.size()==history,"export guard refuses Cut without editing source or history")
	await open_at(1,4);app.physics_editor.recording.active=true;refused=not app.cel_clipboard.perform("cut");app.physics_editor.recording.active=false;app.cel_clipboard.menu.hide();await settled()
	check(refused and app.layers[1].cels==before and app.history.size()==history,"recording guard refuses Cut without editing source or history")
	for i in range(29):app.layers[0].cels.append({"id":"budget"+str(i),"start":i,"duration":1,"image":image})
	app.changed();await open_at(1,40);await action(2)
	check(app.layers[1].cels==before and app.history.size()==history and app.sequence_editor.used("cels")==32,"global32cel budget refuses another paste without mutation")
	app.layers[0].cels.clear();app.changed()
	await open_at(1,4);await action(1)
	check(Drawing.cel_at(app.layers[1],0).is_empty() and app.layers[1].cels.size()==2,"Cut removes exactly clicked source exposure and keeps other drawings")
	app.undo();check(paint_hash(0)==changed and app.layers[1].cels.size()==3,"Cut Undo restores exact source drawing and original boundaries")
	app.redo();check(app.layers[1].cels.size()==2 and Drawing.cel_at(app.layers[1],0).is_empty(),"Cut Redo removes only its target")
	await open_at(1,0);await action(2);check(paint_hash(0)==changed and Drawing.cel_at(app.layers[1],0).duration==8,"cut drawing pastes back with independent pixels and original length")
	# Restore source pixels, then copy them again for deterministic cold fixture.
	var source: Image=Drawing.cel_at(app.layers[1],0).image;source.fill_rect(Rect2i(300,100,30,30),Color.TRANSPARENT);Drawing.touch(source);app.changed()
	check(paint_hash(0)==original,"source variation can be independently restored without touching pasted art")
	check(app.keys==keys and app.current_world()==world,"all clipboard edits leave 3D world and camera keys unchanged")
	await open_at(1,4);await action(0)
	var child: String=app.sequence_editor.new_sequence("Clipboard isolation")
	check(not child.is_empty() and app.sequence_editor.enter(child).is_empty(),"ordinary editable child sequence opens for clipboard ownership test")
	await settled();check(app.cel_clipboard.clipboard.is_empty(),"switching sequence owner releases parent drawing clipboard")
	app.sequence_editor.return_to_parent();await settled();app.undo();await settled()
	check(app.sequence_editor.graph.is_empty() and paint_hash(0)==original and paint_hash(16)==edited,"return and Undo child creation preserve parent drawings")
	await open_at(1,4);await action(0);var old_session: String=app.recovery_session
	app.set_frame(16);await settled();var picture: Image=await app.renderer.capture(app.keys,app.layers,16,true);picture.save_png(folder.path_join("frame16.png"))
	app.has_project.save_file(folder.path_join("clipboard.has"),"packed");await wait_job();check(app.has_project.path==folder.path_join("clipboard.has"),"normal packed Save stores edited clipboard results")
	var error: String=await app.export_movie(folder);check(error.is_empty() and Image.load_from_file(app.last_export_folder.path_join("frame_000017.png")).get_data()==picture.get_data(),"real MP4 frame input equals preview of independently edited pasted cel")
	FileAccess.open(folder.path_join("expected.json"),FileAccess.WRITE).store_string(JSON.stringify({"original":original,"edited":edited,"movie":app.last_export_folder.path_join("movie.mp4")}))
	app.new_project();await settled();check(app.recovery_session!=old_session and app.cel_clipboard.clipboard.is_empty(),"New releases copied raster and prevents paste into another document")
	print("CEL_CLIPBOARD_SMOKE "+JSON.stringify({"checks":checks,"failures":failures,"movie":JSON.parse_string(FileAccess.get_file_as_string(folder.path_join("expected.json"))).movie}));await app.quit_studio();quit(0 if failures==0 else 1)
