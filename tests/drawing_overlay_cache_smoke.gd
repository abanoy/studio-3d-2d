extends "res://tests/movement_path_smoke.gd"
const Drawing=preload("res://src/drawing.gd")
const Storage=preload("res://src/storage.gd")
const Timeline=preload("res://src/timeline.gd")
func _initialize() -> void:
	create_timer(150).timeout.connect(func():push_error("Held drawing preview watchdog");quit(2));call_deferred("run")
func exact_overlay() -> bool:return app.canvas.overlay.get_image().get_data()==Drawing.composite(app.layers,app.frame,1920,1080).get_data()
func run() -> void:
	var args:=OS.get_cmdline_user_args();folder=args[0];app=load("res://main.tscn").instantiate();app.display_prefs_path=folder.path_join("prefs.cfg");app.recovery_root=folder.path_join("recovery");app.recent_path=folder.path_join("recents.json");root.add_child(app);await settled();app.home.hide();app.autosave_enabled.button_pressed=false;app.has_project.cache_root=folder.path_join("reader-cache" if "--read" in args else "writer-cache")
	if "--read" in args:
		var expected: Dictionary=JSON.parse_string(FileAccess.get_file_as_string(folder.path_join("expected.json")));app.has_project.open_file(folder.path_join("held.has"));await wait_job()
		check(app.has_project.path==folder.path_join("held.has") and exact_overlay(),"cold packed Open rebuilds exact visible overlay without writer cache")
		app.set_frame(12);await settled();check(Storage.image_hash(app.layers[1].cels[0].image)==expected.a and exact_overlay(),"cold held preview retains edited source RGBA")
		var captured: Image=await app.renderer.capture(app.keys,app.layers,12,true);check(captured.get_data()==Image.load_from_file(folder.path_join("expected-12.png")).get_data(),"cold final renderer matches original uncached movie input")
		app.set_frame(24);await settled();check(exact_overlay() and Storage.image_hash(app.layers[1].cels[1].image)==expected.b,"cold next exposure chooses correct source")
		print("DRAWING_OVERLAY_CACHE_READ ",JSON.stringify({"checks":checks,"failures":failures}));await app.quit_studio();quit(0 if failures==0 else 1);return
	var source:=folder.path_join("room.glb");preload("res://src/scene3d.gd").make_fixture(source);var source_digest:=FileAccess.get_sha256(source);check(app.load_scene(source).is_empty(),"original independent room imports for held-preview checks")
	check(app.import_audio(folder.path_join("tone.wav"),24).is_empty(),"independent sound retains frame24 start")
	app.keys=[Timeline.key(0,Vector3(0,1,5),Quaternion.IDENTITY,60),Timeline.key(48,Vector3(1,1,5),Quaternion.IDENTITY,60)]
	for at in [0,24]:
		var image:=Drawing.blank(1920,1080);image.fill_rect(Rect2i(100+at*2,100,80,40),Color(.2,.7,.8,.5) if at==0 else Color(.8,.3,.2,.75));Drawing.touch(image);Drawing.insert(app.layers[1],at,48,image)
	app.changed();app.set_frame(0);await settled();var cache=app.drawing_overlay_cache;var builds: int=cache.builds;var hits: int=cache.hits;var camera: Vector3=app.renderer.camera.position
	check(exact_overlay() and cache.image.get_width()*cache.image.get_height()==1920*1080,"actual GPU overlay matches pure compositor and retains one fullHD preview")
	for at in [1,12]:app.set_frame(at);await settled()
	check(cache.builds==builds and cache.hits>=hits+2 and exact_overlay(),"ordinary frame changes within held drawing reuse exact preview pixels")
	check(app.renderer.camera.position!=camera and app.keys[0].position==[0.,1.,5.] and app.audio_clip.start_frame==24,"camera evaluation and independent audio still advance through held ink")
	app.set_frame(24);await settled();check(cache.builds==builds+1 and exact_overlay(),"ordinary next exposure rebuilds correct GPU overlay once")
	app.set_frame(0);await settled();check(cache.builds==builds+2 and exact_overlay(),"reverse seek rebuilds exact previous drawing")
	var image_a: Image=app.layers[1].cels[0].image;image_a.set_pixel(400,300,Color.CYAN);app.changed();await settled()
	check(cache.builds==builds+3 and exact_overlay() and is_same(image_a,app.layers[1].cels[0].image),"same-frame raw raster edit plus ordinary changed notification invalidates preview")
	var original:=image_a.get_data();app.mode.select(0);app.change_mode(0);app.active_layer=1;app.color.color=Color.RED;app.radius.value=6
	var press:=InputEventMouseButton.new();press.button_index=MOUSE_BUTTON_LEFT;press.pressed=true;app.canvas_input(press,Vector2(300,300));app.paint_segment(Vector2(340,300));press.pressed=false;app.canvas_input(press,Vector2(340,300));await settled()
	check(image_a.get_data()!=original and exact_overlay(),"ordinary brush stroke updates cached GPU overlay")
	app.undo();await settled();check(image_a.get_data()==original and exact_overlay(),"pixel Undo restores exact original preview")
	app.redo();await settled();check(image_a.get_data()!=original and exact_overlay(),"pixel Redo restores edited preview");app.undo();await settled()
	app.layer_editor.set_opacity(35);await settled();check(exact_overlay() and app.layers[1].opacity==.35,"opacity change invalidates held preview at same frame")
	app.undo();await settled();check(exact_overlay() and app.layers[1].get("opacity",1.)==1.,"opacity Undo restores full original alpha")
	app.layer_editor.set_visible(false);await settled();check(exact_overlay() and app.canvas.overlay.get_image().is_invisible(),"hidden layer removes cached pixels")
	app.undo();await settled();check(exact_overlay() and not app.canvas.overlay.get_image().is_invisible(),"visibility Undo restores exact drawing")
	var layer_id: String=app.layers[1].id;var cel_id: String=app.layers[1].cels[0].id;var context: Dictionary=app.cel_timing.begin(layer_id,cel_id,4);app.cel_timing.resize(cel_id,12,context);app.set_frame(16);await settled()
	check(exact_overlay() and app.canvas.overlay.get_image().is_invisible(),"shortened exposure clears held pixels in its new gap")
	app.undo();await settled();check(exact_overlay() and not app.canvas.overlay.get_image().is_invisible(),"exposure Undo restores held preview in gap")
	var editor=app.sequence_editor;var child: String=editor.new_sequence("Held preview child");check(not child.is_empty() and editor.enter(child).is_empty(),"editable child opens with independent cache context")
	app.active_layer=1;app.set_frame(0);app.create_cel(false);var child_image: Image=app.layers[1].cels[0].image;child_image.fill_rect(Rect2i(500,200,40,40),Color.MAGENTA);Drawing.touch(child_image);app.changed();await settled();check(exact_overlay(),"child clock shows its own exact drawing preview")
	editor.return_to_parent();app.set_frame(0);await settled();check(exact_overlay() and app.layers[1].cels[0].id==cel_id and is_same(app.layers[1].cels[0].image,image_a),"same-frame parent return cannot reuse child pixels")
	var path:=folder.path_join("held.has");app.has_project.save_file(path,"packed");await wait_job();check(app.has_project.path==path,"held preview document saves normally")
	app.set_frame(12);var expected: Image=await app.renderer.capture(app.keys,app.layers,12,true);expected.save_png(folder.path_join("expected-12.png"))
	var error: String=await app.export_movie(folder);check(error.is_empty(),"normal shared renderer exports held-preview scene")
	check(Image.load_from_file(app.last_export_folder.path_join("frame_000013.png")).get_data()==expected.get_data(),"movie input matches unchanged uncached final renderer exactly")
	var movie: String=app.last_export_folder.path_join("movie.mp4");var a:=Storage.image_hash(image_a);var b:=Storage.image_hash(app.layers[1].cels[1].image)
	app.new_project();await settled();check(exact_overlay() and app.canvas.overlay.get_image().is_invisible(),"New clears old held preview from actual GPU texture")
	app.has_project.open_file(path);await wait_job();check(exact_overlay() and Storage.image_hash(app.layers[1].cels[0].image)==a,"ordinary Open rebuilds exact editable preview")
	check(FileAccess.get_sha256(source)==source_digest,"preview caching/editing/export preserve original room source bytes")
	FileAccess.open(folder.path_join("expected.json"),FileAccess.WRITE).store_string(JSON.stringify({"a":a,"b":b,"movie":movie}))
	print("DRAWING_OVERLAY_CACHE_SMOKE ",JSON.stringify({"checks":checks,"failures":failures,"movie":movie}));await app.quit_studio();quit(0 if failures==0 else 1)
