extends "res://tests/movement_path_smoke.gd"
const SheetData=preload("res://src/reference_sheet_data.gd")
const Storage=preload("res://src/storage.gd")
func run() -> void:
	folder=OS.get_cmdline_user_args()[0];DirAccess.make_dir_recursive_absolute(folder)
	app=load("res://main.tscn").instantiate();app.recovery_root=folder.path_join("recovery");app.recent_path=folder.path_join("recents.json");app.display_prefs_path=folder.path_join("prefs.cfg");root.add_child(app);await settled();app.autosave_enabled.button_pressed=false;app.has_project.cache_root=folder.path_join("has-cache");app.reference_sheet.cache_root=folder.path_join("sheet-cache")
	var lesson=app.tutorials;lesson.set_process(false);check(lesson.start("basic-pose",true),"ordinary included lesson begins for kept-reference checkpoint test");await wait_job()
	var session: String=lesson.session;var sheet=app.reference_sheet;sheet.open();await settled()
	var png:=folder.path_join("Lesson sheet.png");var image:=Image.create(32,16,false,Image.FORMAT_RGBA8);image.fill(Color(.25,.5,.75,.5));image.save_png(png)
	check(sheet.load_sheet(png).is_empty(),"lesson accepts an independent local PNG guide")
	sheet.keep.button_pressed=true;await settled();var reference: Dictionary=sheet.document();check(not reference.is_empty(),"kept reference becomes part of the editable practice scene")
	check(app.new_project() and not lesson.active and sheet.document().is_empty() and sheet.image==null,"New finishes old lesson checkpoint before clearing its kept sheet")
	var resume: String=lesson.store.folder("basic-pose",session).path_join("resume")
	var metadata: Dictionary=JSON.parse_string(FileAccess.get_file_as_string(resume.path_join("project.json")))
	check(metadata.get("schema_version")==7 and metadata.get("reference_sheet",{}).get("sha256")==reference.sha256,"automatic lesson resume retains schema7 reference despite document reset")
	DirAccess.rename_absolute(png,png+".offline")
	check(lesson.start("basic-pose",false,session),"Continue reopens checkpoint while original reference PNG is unavailable")
	await settled();check(lesson.active and sheet.source_hash==reference.sha256 and sheet.image.get_data()==image.get_data() and sheet.keep.button_pressed,"Continue restores exact kept reference pixels and ownership")
	DirAccess.rename_absolute(png+".offline",png)
	lesson.leave(false);print("REFERENCE_LESSON_SMOKE ",JSON.stringify({"checks":checks,"failures":failures}));await app.quit_studio();quit(0 if failures==0 else 1)
