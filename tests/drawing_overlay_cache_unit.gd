extends SceneTree
const Cache=preload("res://src/drawing_overlay_cache.gd")
const Drawing=preload("res://src/drawing.gd")
var checks:=0
var failures:=0
func check(ok: bool,label: String) -> void:
	checks+=1;print(("PASS " if ok else "FAIL ")+label)
	if not ok:failures+=1
func temporary_source(cache) -> WeakRef:
	var source:=Drawing.blank(3,2);source.fill(Color.CYAN)
	cache.sample([{"visible":true,"cels":[{"start":0,"duration":1,"image":source}]}],0,3,2,1)
	return weakref(source)
func _initialize() -> void:
	var cache:=Cache.new();var a:=Drawing.blank(4,3);a.fill(Color(.2,.5,.8,.5));var b:=Drawing.blank(4,3);b.fill(Color(.8,.4,.1,.75))
	var layer: Dictionary={"visible":true,"cels":[{"start":0,"duration":2,"image":a},{"start":2,"duration":2,"image":b}]};var layers: Array=[layer]
	var result:=cache.sample(layers,0,4,3,0);var first: Image=result.image
	check(result.changed and cache.builds==1 and first.get_data()==Drawing.composite(layers,0,4,3).get_data(),"first sample exactly matches uncached RGBA")
	result=cache.sample(layers,1,4,3,0)
	check(not result.changed and is_same(result.image,first) and cache.builds==1 and cache.hits==1,"another frame within hold borrows same image without rebuilding")
	result=cache.sample(layers,2,4,3,0)
	check(result.changed and cache.builds==2 and result.image.get_data()==Drawing.composite(layers,2,4,3).get_data(),"next exposure chooses its distinct original image")
	result=cache.sample(layers,1,4,3,0)
	check(result.changed and result.image.get_data()==first.get_data(),"reverse seek rebuilds exact earlier exposure")
	a.set_pixel(1,1,Color.RED);Drawing.touch(a,Rect2i(1,1,1,1));result=cache.sample(layers,1,4,3,0)
	check(result.changed and result.image.get_data()==Drawing.composite(layers,1,4,3).get_data(),"pixel revision invalidates even at the same playhead")
	a.set_pixel(2,1,Color.GREEN);result=cache.sample(layers,1,4,3,1)
	check(result.changed and result.image.get_data()==Drawing.composite(layers,1,4,3).get_data(),"document revision invalidates raw edits without pixel metadata")
	layer.opacity=.35;result=cache.sample(layers,1,4,3,1)
	check(result.changed and result.image.get_data()==Drawing.composite(layers,1,4,3).get_data(),"layer opacity invalidates exact composited alpha")
	layer.visible=false;result=cache.sample(layers,1,4,3,1)
	check(result.changed and result.image.is_invisible(),"hiding layer removes its pixels")
	a.set_pixel(0,0,Color.MAGENTA);Drawing.touch(a);result=cache.sample(layers,1,4,3,1)
	check(not result.changed and result.image.is_invisible(),"hidden source changes cannot change the blank picture")
	layer.visible=true;result=cache.sample(layers,1,4,3,1)
	check(result.changed and result.image.get_data()==Drawing.composite(layers,1,4,3).get_data(),"revealed layer uses its latest original pixels")
	layer.opacity=0.;result=cache.sample(layers,1,4,3,1)
	check(result.changed and result.image.is_invisible(),"zero opacity removes the image")
	layer.opacity=1.;var top: Dictionary={"visible":true,"cels":[{"start":0,"duration":4,"image":b}]};layers.append(top);result=cache.sample(layers,1,4,3,1);var ordered: PackedByteArray=result.image.get_data();layers.reverse();result=cache.sample(layers,1,4,3,1)
	check(result.changed and result.image.get_data()!=ordered and result.image.get_data()==Drawing.composite(layers,1,4,3).get_data(),"layer order invalidates correct alpha composition")
	layer.cels[0].image=b;result=cache.sample(layers,1,4,3,1)
	check(result.changed and result.image.get_data()==Drawing.composite(layers,1,4,3).get_data(),"replacing source identity invalidates without revision changes")
	result=cache.sample(layers,4,4,3,1)
	check(result.changed and result.image.is_invisible(),"end-exclusive exposure gaps become transparent")
	result=cache.sample(layers,4,2,2,1)
	check(result.changed and result.image.get_size()==Vector2i(2,2),"output dimensions participate in identity")
	var weak:=temporary_source(cache)
	check(weak.get_ref()==null and cache.image!=null and cache.sources[0].get_ref()==null,"cache owns derived pixels but never retains discarded source cels")
	var old: WeakRef=weakref(cache.image);cache.sample([],0,4,3,2)
	check(old.get_ref()==null and cache.image.get_size()==Vector2i(4,3),"only one derived picture survives replacement")
	result=cache.sample([],0,2049,1080,3)
	check(result.changed and cache.image==null and cache.stamp.is_empty() and cache.sources.is_empty(),"oversized picture falls back without retaining beyond fullHD budget")
	cache.sample([],0,4,3,4);cache.clear()
	check(cache.image==null and cache.sources.is_empty() and cache.stamp.is_empty(),"clear releases derived image and weak identities")
	check(a.get_pixel(1,1)==Color.RED and b.get_data()==layer.cels[0].image.get_data(),"cache never changes original artwork")
	print("DRAWING_OVERLAY_CACHE_UNIT ",JSON.stringify({"checks":checks,"failures":failures}));quit(0 if failures==0 else 1)
