	check(moved==expected_move.image.get_data() and app.history.size()==1 and app.history[-1].type=="pixels" and app.history[-1].bytes<1024*1024 and editor.selected==Rect2i(510,450,100,80),"release commits exact move in one bounded tile Undo and retains the shifted selection")
