func _initialize() -> void:
	create_timer(180).timeout.connect(func():push_error("Drawing selection watchdog");quit(2));call_deferred("run")
func mouse(p: Vector2,pressed: bool,shift:=false) -> void:
	var rect: Rect2=app.canvas.image_rect();var e:=InputEventMouseButton.new();e.button_index=MOUSE_BUTTON_LEFT;e.pressed=pressed;e.shift_pressed=shift;e.position=rect.position+(p+Vector2(.5,.5))/Vector2(1920,1080)*rect.size;app.canvas._gui_input(e)
func move(p: Vector2) -> void:
	var rect: Rect2=app.canvas.image_rect();var e:=InputEventMouseMotion.new();e.position=rect.position+(p+Vector2(.5,.5))/Vector2(1920,1080)*rect.size;app.canvas._gui_input(e)
func marquee(from: Vector2,to: Vector2) -> void:mouse(from,true);move(to);mouse(to,false)
func global_release(p: Vector2) -> void:
	var rect: Rect2=app.canvas.image_rect();var e:=InputEventMouseButton.new();e.button_index=MOUSE_BUTTON_LEFT;e.pressed=false;e.position=app.canvas.get_global_transform()*(rect.position+(p+Vector2(.5,.5))/Vector2(1920,1080)*rect.size);app._input(e)
