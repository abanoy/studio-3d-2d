extends "res://tests/movement_path_smoke.gd"
const Drawing=preload("res://src/drawing.gd")
const Storage=preload("res://src/storage.gd")
const Canvas=preload("res://src/canvas_size.gd")
const SceneIO=preload("res://src/scene3d.gd")
func _initialize() -> void:
 create_timer(200).timeout.connect(func():push_error("Native canvas watchdog");quit(2));call_deferred("run")
func run() -> void:
 var args:=OS.get_cmdline_user_args();folder=args[0];var profile:=args[1];var size: Vector2i=Canvas.PROFILES[profile]
 app=load("res://main.tscn").instantiate();app.recovery_root=folder.path_join("recovery");app.recent_path=folder.path_join("recents.json");app.display_prefs_path=folder.path_join("prefs.cfg");root.add_child(app);await settled();app.home.hide();app.autosave_enabled.button_pressed=false;app.has_project.cache_root=folder.path_join("reader-cache" if "--read" in args else "writer-cache")
 if "--read" in args:
  app.has_project.open_file(folder.path_join("native.has"));await wait_job();var expected: Dictionary=JSON.parse_string(FileAccess.get_file_as_string(folder.path_join("expected.json")))
  check(Vector2i(app.video.width,app.video.height)==size and app.renderer.viewport.size==size and app.canvas.resolution==Vector2(size),"fresh packed Open installs native canvas, viewport and drawing coordinates")
  check(Storage.image_hash(Drawing.image(app.layers[1].cels[0]))==expected.pixels,"fresh packed Open restores exact editable native pixels")
  check(app.selected_output_size()==profile,"fresh project without delivery override defaults to its native size")
  check(app.video.fps_num==expected.fps_num and app.video.fps_den==expected.fps_den and app.video.duration_frames==expected.duration_frames,"fresh native project retains rational timing and scene length")
  check(Storage.RasterReader.digest_bytes(app.audio_mix.pcm)==expected.pcm,"fresh native project restores exact independently synchronized audio mix")
  var picture: Image=await app.renderer.capture(app.keys,app.layers,0,true)
  check(picture.get_size()==size and picture.get_data()==Image.load_from_file(folder.path_join("expected-frame.png")).get_data(),"fresh final composition equals writer at native dimensions")
  print("NATIVE_CANVAS_READ "+JSON.stringify({"checks":checks,"failures":failures}));await app.quit_studio();quit(0 if failures==0 else 1);return
 check(Canvas.profile(app.video)=="1080p" and app.renderer.viewport.size==Vector2i(1920,1080),"New keeps effortless1080p default")
 var source:=folder.path_join("original.glb");SceneIO.make_fixture(source);var original:=FileAccess.get_sha256(source)
 check(app.load_scene(source).is_empty(),"owned external3D reference loads before choosing native canvas")
 var world: Dictionary=app.current_world().duplicate(true);var keys: Array=app.keys.duplicate(true)
 app.show_project_options();await settled()
 check(app.project_canvas.choices.item_count==3 and app.project_options.size.y<=root.size.y,"actual project options offers bounded native choices in a scrollable dialog")
 var before: int=app.history.size();var projected: Vector2=app.renderer.camera.unproject_position(Vector3.ZERO)
 check(app.project_canvas.apply(profile).is_empty() and app.history.size()==before+1,"native canvas Apply creates one reversible project setting")
 await settled()
 check(Vector2i(app.video.width,app.video.height)==size and app.renderer.viewport.size==size and app.canvas.resolution==Vector2(size),"native setting changes storage, renderer and pointer coordinate contract together")
 check(app.renderer.camera.unproject_position(Vector3.ZERO).distance_to(projected*float(size.x)/1920.0)<.01 and app.current_world()==world and app.keys==keys,"native viewport scales projection without changing external world or camera keys")
 check(app.selected_output_size()==profile and not app.video.has("output_size"),"delivery defaults to native size without a redundant override")
 app.undo();await settled();check(Canvas.profile(app.video)=="1080p" and app.renderer.viewport.size==Vector2i(1920,1080),"native size Undo restores1080p and viewport")
 app.redo();await settled();check(Canvas.profile(app.video)==profile and app.renderer.viewport.size==size,"native size Redo restores requested coordinate contract")
 if profile=="540p":
  check(app.project_timing.apply_values(24000,1001).is_empty() and app.project_timing.apply_duration(60).is_empty(),"native540p supports rational rate and changed scene duration without retiming source frames")
 app.project_options.hide();app.mode.select(0);app.change_mode(0);app.set_frame(0);app.tool.select(0);app.color.color=Color.RED;app.radius.value=5
 var rect: Rect2=app.canvas.image_rect();var point:=Vector2(size)*Vector2(.4,.35)
 for down in [true,false]:
  var event:=InputEventMouseButton.new();event.button_index=MOUSE_BUTTON_LEFT;event.pressed=down;event.position=rect.position+point/Vector2(size)*rect.size;app.canvas._gui_input(event)
 await settled();var cel: Dictionary=app.layers[1].cels[0];var pixels: Image=Drawing.image(cel);var hash:=Storage.image_hash(pixels)
 check(pixels.get_size()==size and pixels.get_pixelv(Vector2i(point)).r>.9 and pixels.get_pixel(0,0).a==0,"actual canvas pointer paints the expected native pixel with no rescaled backing")
 check(app.canvas.overlay.get_image().get_data()==Drawing.composite(app.layers,0,size.x,size.y).get_data(),"actual GPU drawing preview equals native raster composition")
 app.undo();await settled();check(Drawing.image(cel).get_pixelv(Vector2i(point)).a==0,"native brush Undo restores exact transparent source pixels")
 app.redo();await settled();check(Storage.image_hash(Drawing.image(cel))==hash,"native brush Redo restores exact painted pixels")
 var unchanged: Dictionary=app.video.duplicate(true);before=app.history.size()
 check(not app.project_canvas.apply("1080p").is_empty() and app.video==unchanged and app.history.size()==before,"size change refuses existing artwork without altering history or canvas")
 app.delete_cel();await settled();check(not app.project_canvas.apply("1080p").is_empty() and app.video==unchanged,"deleted artwork retained by Undo also prevents destructive canvas change")
 app.undo();await settled();check(Storage.image_hash(Drawing.image(app.layers[1].cels[0]))==hash,"deleted native drawing restores through structural Undo")
 check(app.import_audio(folder.path_join("tone.wav"),24).is_empty(),"native canvas keeps independent frame24 audio alignment")
 var picture: Image=await app.renderer.capture(app.keys,app.layers,0,true);picture.save_png(folder.path_join("expected-frame.png"))
 var directory:=folder.path_join("directory");check(Storage.save_project(directory,app.video,app.keys,app.layers,"",0,{},{},{},true,app.current_world()).is_empty(),"native directory save validates and writes exact canvas pixels")
 var loaded:=Storage.load_project(directory);check(not loaded.has("error") and Canvas.profile(loaded.video)==profile and Storage.image_hash(Drawing.image(loaded.layers[1].cels[0]))==hash,"native directory Open retains dimensions and exact editable pixels")
 app.has_project.save_file(folder.path_join("native.has"),"packed");await wait_job();check(FileAccess.file_exists(folder.path_join("native.has")),"ordinary packed Save accepts native canvas")
 var manual:=FileAccess.get_sha256(folder.path_join("native.has"));var error: String=await app.export_movie(folder)
 check(error.is_empty() and Image.load_from_file(app.last_export_folder.path_join("frame_000001.png")).get_data()==picture.get_data(),"native movie input equals actual final preview with no delivery resize")
 var movie: String=app.last_export_folder.path_join("movie.mp4")
 var png_error: String=await app.export_images(folder,true);var png_folder: String=app.last_export_folder
 check(png_error.is_empty() and Image.load_from_file(png_folder.path_join("frame_000001.png")).get_data()==Drawing.composite(app.layers,0,size.x,size.y).get_data(),"native transparent PNG sequence preserves exact editable alpha pixels")
 app.changed();app.autosave_tick(true);await preload("res://tests/recovery_wait.gd").checkpoint(app)
 while app.recovery_preview.busy():app.poll_recovery_preview();await process_frame
 var checkpoint: String=app.recovery_root.path_join(app.recovery_session)
 check(app.open_project(checkpoint) and Canvas.profile(app.video)==profile and Storage.image_hash(Drawing.image(app.layers[1].cels[0]))==hash,"real recovery checkpoint restores native dimensions and editable pixels")
 check(FileAccess.get_sha256(source)==original and FileAccess.get_sha256(folder.path_join("native.has"))==manual,"native edits/export/recovery preserve original external3D and manual HAS bytes")
 app.mode.select(0);app.change_mode(0);app.set_frame(0)
 var child: String=app.sequence_editor.new_sequence("Native child")
 check(not child.is_empty() and app.sequence_editor.enter(child).is_empty() and app.renderer.viewport.size==size,"native child editor inherits exact canvas and viewport")
 app.active_layer=1;app.set_frame(0);app.create_cel(false);var child_cel: Dictionary=app.layers[1].cels[0];var child_pixels:=Drawing.edit_image(child_cel);var child_point:=Vector2i(size.x*7/10,size.y*7/10)
 child_pixels.image.fill_rect(Rect2i(child_point-Vector2i(10,10),Vector2i(20,20)),Color.BLUE);Drawing.touch(child_pixels.image);app.changed();app.sequence_editor.return_to_parent();await settled()
 var clip: String=app.sequence_editor.graph.clips[0].id
 check(app.sequence_editor.change_mask(clip,{"rect":[size.x/2,size.y/2,size.x/2,size.y/2],"invert":false}).is_empty(),"native child picture mask accepts actual canvas bounds")
 check(not app.sequence_editor.change_mask(clip,{"rect":[size.x-1,size.y-1,2,2],"invert":false}).is_empty(),"picture mask outside native canvas refuses without changing graph")
 var nested: Image=await app.renderer.capture(app.keys,app.layers,0,true)
 check(nested.get_size()==size and nested.get_pixelv(child_point).b>.95,"native nested compositor places masked child pixels at exact native coordinates")
 app.has_project.save_file(folder.path_join("nested.has"),"packed");await wait_job();check(FileAccess.file_exists(folder.path_join("nested.has")),"native nested HAS worker actually commits the saved file");app.has_project.open_file(folder.path_join("nested.has"));await wait_job();check(app.has_project.path==folder.path_join("nested.has"),"native nested HAS actually reopens the committed file")
 var reopened: Image=await app.renderer.capture(app.keys,app.layers,0,true)
 check(app.sequence_editor.graph.assets.size()==1 and reopened.get_data()==nested.get_data(),"native nested packed Open preserves editable child and exact masked composition")
 var expected:={"pixels":hash,"movie":movie,"png_sequence":png_folder,"source_sha256":original,"pcm":Storage.RasterReader.digest_bytes(app.audio_mix.pcm),"fps_num":app.video.fps_num,"fps_den":app.video.fps_den,"duration_frames":app.video.duration_frames,"checks":checks,"failures":failures}
 var out:=FileAccess.open(folder.path_join("expected.json"),FileAccess.WRITE);out.store_string(JSON.stringify(expected));out.close()
 print("NATIVE_CANVAS_SMOKE "+JSON.stringify(expected));await app.quit_studio();quit(0 if failures==0 else 1)
