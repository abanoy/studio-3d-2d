extends "res://tests/movement_path_smoke.gd"
const Drawing=preload("res://src/drawing.gd")
func _initialize() -> void:
	create_timer(150).timeout.connect(func():push_error("Timeline navigation watchdog");quit(2));call_deferred("run")
func wheel(view: Control,point: Vector2,index: int,ctrl:=false,shift:=false) -> void:
	for pressed in [true,false]:
		var event:=InputEventMouseButton.new();event.button_index=index;event.pressed=pressed;event.ctrl_pressed=ctrl;event.shift_pressed=shift;event_at(view,point,event);await process_frame
	await settled()
func run() -> void:
	folder=OS.get_cmdline_user_args()[0];DirAccess.make_dir_recursive_absolute(folder)
	app=load("res://main.tscn").instantiate();app.display_prefs_path=folder.path_join("prefs.cfg");app.recovery_root=folder.path_join("recovery");app.recent_path=folder.path_join("recents.json");root.add_child(app);await settled();app.home.hide();app.autosave_enabled.button_pressed=false
	app.show_project_options();app.project_options.hide();check(app.project_timing.apply_duration(1440).is_empty(),"long parent opens for navigation")
	var source:=folder.path_join("figure.glb");preload("res://src/scene3d.gd").make_pose_fixture(source)
	check(app.pose_editor.add_model(source).is_empty(),"original rig imports for fixed model/channel labels")
	app.set_frame(1300);app.pose_editor.selected="@root";app.pose_editor.operation.select(1);app.pose_editor.refresh_values();app.pose_editor.fields[0].value+=.25;app.pose_editor.apply_numeric()
	var view=app.timeline;var ruler=app.timeline_ruler;var nav=app.timeline_navigation
	check(nav.span==0 and view.frame_at(Vector2(view.LEFT,0))==0 and view.frame_at(Vector2(view.size.x-16,0))==1440,"Fit maps full parent to both endpoint boundaries")
	app.set_frame(1200);var history: int=app.history.size();var revision: int=app.recovery_revision
	for i in range(5):await click(nav.zoom_in)
	check(nav.visible()==45 and view.window_span==ruler.window_span and view.window_start==ruler.window_start,"five zoom clicks keep ruler and tracks on same45frame range")
	check(absf(view.x(1201)-view.x(1200))>4,"late neighboring frames have separate pointer targets")
	check(app.history.size()==history and app.recovery_revision==revision,"zoom is session-only without content history or dirty revision")
	await click_at(ruler,Vector2(ruler.x(1201),10));check(app.frame==1201,"real ruler click selects exact late neighboring frame")
	check(not nav.zoom_in.disabled and not nav.fit.disabled,"navigation buttons become available after seek release")
	await click_at(view,Vector2(9,view.row_y(0)+12));check(view.visual_rows.size()>view.object_rows.size(),"model expands to animated channels while zoomed")
	var before: float=view.visible_span();var at:=Vector2(view.x(1201),10)
	await wheel(ruler,at,MOUSE_BUTTON_WHEEL_UP,true)
	check(view.visible_span()==before*.5 and absf(ruler.x(1201)-at.x)<1,"Ctrl wheel zoom keeps pointer frame anchored")
	var old_start: float=nav.start;await wheel(ruler,at,MOUSE_BUTTON_WHEEL_DOWN,false,true)
	check(nav.start>old_start and view.window_start==ruler.window_start,"Shift wheel pans both ruler and tracks")
	nav.scrollbar.value=800;await settled();check(nav.start==800 and view.frame_at(Vector2(view.LEFT,0))==800,"horizontal scrollbar pans to exact frame")
	app.set_frame(1300);await settled();check(view.x(1300)>=view.LEFT and view.x(1300)<=view.size.x-16,"numeric navigation reveals a distant playhead")
	var saved_start: float=nav.start;nav.tracks.dragging=true;nav.zoom(.5,1300);nav.tracks.dragging=false
	check(nav.start==saved_start and nav.visible()==before*.5,"active seek gesture freezes zoom transform")
	var audio: String=app.import_audio(folder.path_join("tone.wav"),1296);check(audio.is_empty(),"late sound imports for zoomed waveform and drag")
	app.mode.select(0);app.change_mode(0);app.set_frame(1300);app.active_layer=1;app.create_cel(false)
	Drawing.edit_image(Drawing.cel_at(app.layers[1],1300)).image.fill_rect(Rect2i(100,100,40,40),Color.CYAN);Drawing.touch(Drawing.image(Drawing.cel_at(app.layers[1],1300)));app.changed()
	await settled();var preview: Image=await app.renderer.capture(app.keys,app.layers,1300,true)
	var point:=Vector2(view.x(1297),view.audio_y()+14)
	var screen: Image=app.get_viewport().get_texture().get_image();screen.save_png(folder.path_join("zoomed.png"))
	var left_before:=screen.get_region(Rect2i(Vector2i(view.global_position),Vector2i(185,mini(100,int(view.size.y))))).get_data()
	nav.navigate("right",1300);await settled()
	screen=app.get_viewport().get_texture().get_image();var left_after:=screen.get_region(Rect2i(Vector2i(view.global_position),Vector2i(185,mini(100,int(view.size.y))))).get_data()
	check(left_before==left_after,"panning leaves fixed label pixels unchanged even with offscreen blocks")
	nav.scrollbar.value=1300;await settled();var previous_frame: int=app.frame
	await click_at(view,Vector2(80,view.audio_y()+14));check(app.frame==previous_frame and not view.audio_gesture_active(),"fixed sound label selects without seeking or grabbing offscreen audio")
	await click_at(ruler,Vector2(80,10));check(app.frame==previous_frame,"fixed Camera label does not seek into hidden timeline time")
	nav.scrollbar.value=1290;await settled();point=Vector2(view.x(1297),view.audio_y()+14)
	var original: Dictionary=app.audio_document().duplicate(true);history=app.history.size()
	await drag(view,point,Vector2(view.x(1298)-view.x(1297),0))
	check(app.audio_clips[0].start_frame==1297 and app.history.size()==history+1,"zoomed sound drag moves exactly one frame in one Undo")
	app.undo();check(app.audio_document()==original,"zoomed sound drag Undo restores exact clip metadata")
	var rect: Rect2=view.audio_rect(0);var last: int=preload("res://src/audio_track.gd").last_frame(app.audio_clips[0],app.video);history=app.history.size()
	await drag(view,Vector2(rect.end.x-2,view.audio_y()+14),Vector2(view.x(1306)-view.x(1307),0))
	check(app.history.size()==history+1 and preload("res://src/audio_track.gd").last_frame(app.audio_clips[0],app.video)==last-1,"zoomed sound right-edge trim shortens exactly one frame")
	app.undo();check(app.audio_document()==original,"zoomed right-edge Undo restores exact source trim")
	var world: Dictionary=app.current_world().duplicate(true);history=app.history.size()
	var model_point:=Vector2(view.x(1300)+4,view.row_y(0)+12)
	var piece_id: String=view.piece_at(world.objects[0],0,model_point)
	var piece_index: int=preload("res://src/animation_clips.gd").index_id(world.objects[0],piece_id)
	await drag(view,model_point,Vector2(view.x(1301)-view.x(1300),0))
	check(piece_index>=0 and app.current_world().objects[0].animation_clips[piece_index].start==world.objects[0].animation_clips[piece_index].start+1 and app.history.size()==history+1,"zoomed model piece drag shifts its block exactly one frame")
	app.undo();check(app.current_world()==world,"zoomed model Undo restores exact authored world")
	var picture: Image=await app.renderer.capture(app.keys,app.layers,1300,true)
	check(picture.get_data()==preview.get_data(),"timeline navigation and sound drag leave scene pixels unchanged")
	await click(nav.fit);check(nav.span==0 and nav.start==0 and view.window_span==0 and ruler.window_span==0,"Fit restores complete shared timeline")
	for i in range(12):nav.zoom(.5,1300)
	check(nav.visible()==12,"minimum zoom range stays bounded to12frames")
	app.new_project();await settled();check(nav.span==0 and nav.start==0 and view.duration==48,"New resets zoom and pan without changing personal workspace")
	app.timeline_navigation.zoom(.5,24);app.workspace_layout.float_panel("timeline");await settled()
	check(is_instance_valid(nav.bar) and nav.bar.get_window()==ruler.get_window() and ruler.window_span==view.window_span,"floating timeline carries shared zoom controls with ruler and tracks")
	var floating_span: float=nav.visible();await wheel(ruler,Vector2(ruler.x(24),10),MOUSE_BUTTON_WHEEL_UP,true)
	check(nav.visible()<floating_span and ruler.window_span==view.window_span,"floating timeline routes actual Ctrl wheel to both views")
	app.workspace_layout.dock("timeline","bottom");await settled()
	app.get_window().size=Vector2i(1200,760);await settled();check(nav.bar.size.x*app.get_viewport().get_screen_transform().get_scale().x<=app.get_window().size.x and ruler.size.x==view.size.x,"navigation and ruler fit smaller docked window")
	var path:=folder.path_join("navigation.has");app.has_project.cache_root=folder.path_join("has-cache");app.has_project.save_file(path,"packed");await wait_job()
	var digest:=FileAccess.get_sha256(path);app.has_project.open_file(path);await wait_job()
	check(nav.span==0 and nav.start==0 and FileAccess.get_sha256(path)==digest,"Open resets session range and leaves manual HAS byte-identical")
	app.set_frame(0);var child: String=app.sequence_editor.new_sequence("View context");app.sequence_editor.enter(child);await settled()
	check(nav.span==0 and view.window_span==ruler.window_span,"entering child resets both timeline views")
	nav.zoom(.5,0);app.sequence_editor.return_to_parent();await settled();check(nav.span==0 and nav.start==0,"returning to parent resets view without importing child zoom")
	app.get_viewport().get_texture().get_image().save_png(folder.path_join("fit.png"))
	print("TIMELINE_NAVIGATION_SMOKE ",JSON.stringify({"checks":checks,"failures":failures}));await app.quit_studio();quit(0 if failures==0 else 1)
